import numpy as np
import matplotlib.pyplot as plt

# Function to apply the transformation and visualize it
def visualize_transform(data, transform_fn, title='Transformation Visualization'):
    # Original Data Visualization
    plt.figure(figsize=(10, 5))
    plt.subplot(1, 2, 1)
    plt.scatter(np.arange(len(data)), data, color='blue', label='Original Data')
    plt.title('Original Data')
    plt.xlabel('Index')
    plt.ylabel('Value')
    plt.legend()
    
    # Apply Transformation
    transformed_data = np.array([transform_fn(x) for x in data])
    
    # Transformed Data Visualization
    plt.subplot(1, 2, 2)
    plt.scatter(np.arange(len(transformed_data)), transformed_data, color='red', label='Transformed Data')
    plt.title('Transformed Data')
    plt.xlabel('Index')
    plt.ylabel('Value')
    plt.legend()
    
    plt.suptitle(title)
    plt.tight_layout()
    plt.show()

# Example Usage
if __name__ == "__main__":
    np.random.seed(42)
    data = np.random.uniform(1, 100, 50)  # Random dataset between 1 and 100
    transform_fn = lambda x: x**(1/2)  # Square root transformation
    visualize_transform(data, transform_fn, title='Square Root Transformation')

    


